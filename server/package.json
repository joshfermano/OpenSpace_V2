{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "nodemon": "nodemon src/server.ts",
    "dev": "ts-node-dev --respawn --transpile-only -P tsconfig.dev.json src/server.ts",
    "Dev": "npx ts-node --transpile-only -P tsconfig.dev.json src/server.ts",
    "build": "tsc -p tsconfig.deploy.json",
    "prebuild": "echo 'Skipping preinstall during build'",
    "watch": "tsc -w",
    "render-build": "npm install --force && npm run build && npm prune --production",
    "prod-build": "npm install && npm run build && npm prune --production",
    "fix-build": "rimraf dist && npm install --save-dev @types/express && npm install && npx tsc --project tsconfig.deploy.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "express-rate-limit": "^6.9.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.0",
    "nodemon": "^3.1.10",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.16",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.15.3",
    "@types/nodemon": "^1.19.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "glob": "^11.0.1",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "ts2js": "^4.1.0-dev.5",
    "typescript": "^5.8.3"
  }
}
